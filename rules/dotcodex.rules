# Prefix rules apply to commands outside the sandbox, not every possible Git invocation.
prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master", "HEAD:main", "HEAD:master"]],
    decision = "forbidden",
    justification = "Push an explicit feature branch and open a PR instead.",
    match = ["git push origin main", "git push origin HEAD:master"],
    not_match = ["git push origin feature/example"],
)
prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--mirror", "--all"]],
    decision = "prompt",
    justification = "Review destructive or broad pushes; explicit user authorization is required.",
)
